# printscan edge 환경설정 예시 → /opt/printscan-edge/edge.env 로 복사해 수정.
# Spring relaxed binding: 대문자+언더스코어 = printscan.* 프로퍼티에 매핑됨.

# 이 유닛이 담당하는 생산 라인 이름(소비 집계 귀속)
PRINTSCAN_LINE_NAME=1라인

# 프린터 출력 경로: cups(호스트 CUPS raw 큐, USB 권장) | network(IP:9100) | rawdev(/dev/usb/lp0)
PRINTSCAN_PRINTER_MODE=cups
PRINTSCAN_PRINTER_NAME=zebra,zd421
# network 모드일 때: PRINTSCAN_PRINTER_HOST=192.168.0.50

# 라벨 한글 폰트(Pi 에 fonts-noto-cjk 설치 시 자동 해석)
PRINTSCAN_LABEL_FONT_FAMILY=Noto Sans CJK KR

# 클라우드/온프렘 허브 연동
PRINTSCAN_CLOUD_ENABLED=true
PRINTSCAN_CLOUD_BASE_URL=http://hub.factory.lan:8092
PRINTSCAN_CLOUD_ORG_API_KEY=ORG-DEMO-KEY
PRINTSCAN_CLOUD_DEVICE_NAME=edge-1라인
